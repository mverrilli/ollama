-#if defined(__linux__)
-    FILE * f = fopen("/proc/self/status", "r");
-    size_t size = 0;
-    char * line = NULL;
-    ssize_t length = 0;
-    while ((length = getline(&line, &size, f)) > 0) {
-        if (!strncmp(line, "TracerPid:", sizeof("TracerPid:") - 1) &&

-static struct ggml_tensor * ggml_glu_impl(
-        struct ggml_context * ctx,
-        struct ggml_tensor  * a,
-        struct ggml_tensor  * b,
-        enum ggml_glu_op      op,
-        bool                  swapped) {
-    GGML_ASSERT(ggml_is_contiguous_1(a));
-
-    if (b) {
-        GGML_ASSERT(ggml_is_contiguous_1(b));

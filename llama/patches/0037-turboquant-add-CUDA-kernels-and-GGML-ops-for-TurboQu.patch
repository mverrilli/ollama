-        ggml_print_backtrace_symbols();
-        _Exit(0);
-    } else { // parent
-#if defined(__linux__)
-        prctl(PR_SET_PTRACER, child_pid);
-        close(lock[1]);
-        close(lock[0]);
-#endif
-        waitpid(child_pid, NULL, 0);
-    }
-}
